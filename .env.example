# LA BOUSSOLE — root .env (consumed by docker-compose).
# Copy to .env to override defaults.

MYSQL_DATABASE=laboussole
MYSQL_USER=laboussole
MYSQL_PASSWORD=laboussole
MYSQL_ROOT_PASSWORD=root_password

# 32+ bytes (raw or base64). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000
